---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, industryHeroTitles, industryNames, languages, routes, type Language } from '../../data/site';

export function getStaticPaths() {
  return languages.flatMap((lang) => routes.map((slug) => ({ params: { lang, slug: slug || undefined } })));
}
const { lang, slug: rawSlug } = Astro.params as { lang: Language; slug?: string };
const slug = rawSlug || '';
const t = copy[lang];
const industry = industryNames[slug];
const title = industry ? `${industry[lang]}: ${t.home.title}` : slug === 'buchung' ? t.booking.title : slug === 'tippgeber' ? t.referral.title : slug === 'agb' ? t.legal.terms : slug === 'datenschutz' ? t.legal.privacy : slug === 'impressum' ? t.legal.imprint : t.home.title;
const localized = (de: string, en: string, fr: string, es: string) => ({ de, en, fr, es }[lang]);
const article = slug.includes('handwerksbetrieb') || slug.includes('unternehmensnachfolge-im-handwerk');
const valuePage = ['persoenlich', 'diskretion', 'netzwerk', 'provisionsfrei', 'persoenliche-betreuung'].includes(slug);
---
<BaseLayout {lang} {slug} {title} description={industry ? `${industry[lang]}. ${t.home.description}` : t.home.description}>
  {slug === '' && <main>
    <section class="hero"><p class="eyebrow">{t.home.eyebrow}</p><h1>{t.home.title}</h1><p class="lead">{t.home.lead}</p><p><a class="button" href={`/${lang}/buchung/`}>{t.home.cta}</a></p></section>
    <section class="section" id="industries"><p class="eyebrow">MERGIU</p><h2>{t.home.industries}</h2><div class="cards">{Object.entries(industryNames).map(([key, names]) => <a class="card" href={`/${lang}/${key}/`}><h3>{names[lang]}</h3><p>{localized('Passende Nachfolger, Käufer und Investoren für Ihr Unternehmen.', 'Suitable successors, buyers and investors for your business.', 'Des repreneurs, acheteurs et investisseurs adaptes a votre entreprise.', 'Sucesores, compradores e inversores adecuados para su empresa.')}</p></a>)}</div></section>
    <section class="section"><div class="split"><div><p class="eyebrow">{t.shared.howItWorks}</p><h2>{t.home.process}</h2><p>{t.shared.confidential}</p></div><div class="steps">{t.home.steps.map((step, index) => <article class="step"><b>0{index + 1}</b><h3>{step}</h3></article>)}</div></div></section>
  </main>}

  {industry && <main><section class="hero"><p class="eyebrow">{industry[lang]}</p><h1>{industryHeroTitles[slug][lang]}</h1><p class="lead">{t.home.lead}</p><a class="button" href={`/${lang}/buchung/`}>{t.home.cta}</a></section><section class="section"><div class="split"><div><p class="eyebrow">{t.shared.howItWorks}</p><h2>{localized('Der passende Nachfolger fuer Ihr Unternehmen.', 'The right successor for your business.', 'Le bon repreneur pour votre entreprise.', 'El sucesor adecuado para su empresa.')}</h2></div><div><p>{localized('Eine Nachfolge ist mehr als ein Verkauf. Erfahrung, Mitarbeiter, Kundenbeziehungen und die Zukunft Ihres Unternehmens verdienen eine sorgfältige Betrachtung.', 'A succession is more than a sale. Experience, employees, customer relationships and your company’s future deserve careful consideration.', 'Une transmission est plus qu’une vente. L’experience, les equipes, les relations clients et l’avenir de votre entreprise meritent une attention particuliere.', 'Una sucesion es mas que una venta. La experiencia, los empleados, las relaciones con clientes y el futuro de su empresa merecen una consideracion cuidadosa.')}</p><p>{t.shared.confidential}</p></div></div></section><section class="section"><h2>{t.home.process}</h2><div class="steps">{t.home.steps.map((step, index) => <article class="step"><b>0{index + 1}</b><h3>{step}</h3></article>)}</div></section></main>}

  {valuePage && <main><section class="hero"><p class="eyebrow">MERGIU</p><h1>{slug === 'diskretion' ? localized('Vertraulichkeit von Anfang an.', 'Confidentiality from the start.', 'La confidentialite des le depart.', 'Confidencialidad desde el principio.') : slug === 'netzwerk' ? localized('Die richtige Verbindung macht den Unterschied.', 'The right connection makes the difference.', 'La bonne connexion fait la difference.', 'La conexion adecuada marca la diferencia.') : slug === 'provisionsfrei' ? localized('Keine Verkaufsprovision fuer Verkaeufer.', 'No sales commission for sellers.', 'Aucune commission de vente pour les vendeurs.', 'Sin comision de venta para vendedores.') : localized('Die richtige Verbindung entsteht persoenlich.', 'The right connection is personal.', 'La bonne connexion est personnelle.', 'La conexion adecuada es personal.')}</h1><p class="lead">{t.home.lead}</p></section><section class="section"><h2>{localized('Ein Ansatz, der zu Ihrem Unternehmen passt.', 'An approach that fits your business.', 'Une approche adaptee a votre entreprise.', 'Un enfoque que se adapta a su empresa.')}</h2><div class="cards">{['01', '02', '03', '04'].map((number) => <article class="card"><b>{number}</b><h3>{t.shared.confidential}</h3><p>{t.home.lead}</p></article>)}</div></section></main>}

  {slug === 'buchung' && <main><section class="hero"><p class="eyebrow">MERGIU</p><h1>{t.booking.title}</h1><p class="lead">{t.booking.lead}</p></section><section class="section"><div class="split"><div><h2>184 EUR</h2><ul>{t.booking.included.map((item) => <li>{item}</li>)}</ul><p class="notice">{t.booking.note}</p></div><form class="form"><label>{localized('Unternehmen', 'Company', 'Entreprise', 'Empresa')}<input required /></label><label>{localized('E-Mail-Adresse', 'Email address', 'Adresse e-mail', 'Correo electronico')}<input type="email" required /></label><label><input type="checkbox" required /> {t.booking.consent}</label><button class="button" type="submit">{t.booking.submit}</button></form></div></section></main>}

  {slug === 'tippgeber' && <main><section class="hero"><p class="eyebrow">MERGIU</p><h1>{t.referral.title}</h1><p class="lead">{t.referral.lead}</p><p class="notice">{t.referral.reward}</p></section><section class="section"><h2>{t.shared.howItWorks}</h2><div class="steps">{t.referral.steps.map((step, index) => <article class="step"><b>0{index + 1}</b><h3>{step}</h3></article>)}</div></section><section class="section"><h2>{t.referral.formTitle}</h2><form class="form"><label>{localized('Ihr Name', 'Your name', 'Votre nom', 'Su nombre')}<input required /></label><label>{localized('Ihre E-Mail-Adresse', 'Your email address', 'Votre adresse e-mail', 'Su correo electronico')}<input type="email" required /></label><label>{localized('Ihr Hinweis', 'Your referral', 'Votre information', 'Su referencia')}<textarea required rows="6"></textarea></label><button class="button">{t.referral.formTitle}</button></form></section></main>}

  {article && <main><section class="hero"><p class="eyebrow">{localized('Unternehmensnachfolge', 'Business succession', 'Transmission d’entreprise', 'Sucesion empresarial')}</p><h1>{localized('Den passenden Nachfolger fuer einen Handwerksbetrieb finden.', 'Finding the right successor for a craft business.', 'Trouver le bon repreneur pour une entreprise artisanale.', 'Encontrar al sucesor adecuado para una empresa artesanal.')}</h1></section><article class="section legal"><p>{localized('Eine frühzeitige und strukturierte Vorbereitung schafft Handlungsspielraum bei der Unternehmensnachfolge.', 'Early, structured preparation creates room for action in business succession.', 'Une preparation anticipee et structuree donne une marge de manoeuvre pour la transmission.', 'Una preparacion temprana y estructurada crea margen de accion en la sucesion empresarial.')}</p><h2>{localized('Fruehzeitig planen', 'Plan early', 'Planifier tot', 'Planificar con antelacion')}</h2><p>{t.home.lead}</p><h2>{localized('Den richtigen Kontakt finden', 'Find the right contact', 'Trouver le bon contact', 'Encontrar el contacto adecuado')}</h2><p>{t.shared.confidential}</p></article></main>}

  {['agb', 'datenschutz', 'impressum'].includes(slug) && <main class="section"><article class="legal"><p class="eyebrow">MERGIU</p><h1>{slug === 'agb' ? t.legal.terms : slug === 'datenschutz' ? t.legal.privacy : t.legal.imprint}</h1><p class="notice">{t.legal.translation}</p><section><h2>{localized('Anbieter', 'Provider', 'Prestataire', 'Proveedor')}</h2><p><strong>VIRALNATION LTD</strong><br />Georgiou Anastasi, 5 - 202, 8021 Paphos, Cyprus<br />VAT ID: CY10429630T<br /><a href="mailto:anfrage@mergiu.com">anfrage@mergiu.com</a></p></section><section><h2>{localized('Geltungsbereich und Informationen', 'Scope and information', 'Champ d’application et informations', 'Ambito e informacion')}</h2><p>{localized('Diese Seite stellt die lokalisierte Informationsfassung der deutschen rechtlichen Inhalte bereit. Vor Abschluss eines Vertrags und vor einer Veröffentlichung muss die jeweils maßgebliche deutsche Originalfassung geprüft werden.', 'This page provides a localised information version of the German legal content. The authoritative German original must be reviewed before entering into a contract or publishing.', 'Cette page fournit une version informative localisee du contenu juridique allemand. La version originale allemande applicable doit etre verifiee avant toute conclusion de contrat ou publication.', 'Esta pagina ofrece una version informativa localizada del contenido juridico aleman. La version original alemana aplicable debe revisarse antes de celebrar un contrato o publicar.')}</p></section><section><h2>{localized('Kontakt', 'Contact', 'Contact', 'Contacto')}</h2><p><a href="mailto:anfrage@mergiu.com">anfrage@mergiu.com</a></p></section></article></main>}

  {slug === 'category' && <main class="section"><h1>{t.nav.insights}</h1><div class="cards"><a class="card" href={`/${lang}/handwerksbetrieb-verkaufen-nachfolger-finden/`}><h2>{localized('Handwerksbetrieb verkaufen', 'Selling a craft business', 'Vendre une entreprise artisanale', 'Vender una empresa artesanal')}</h2><p>{t.shared.learnMore}</p></a></div></main>}
</BaseLayout>
